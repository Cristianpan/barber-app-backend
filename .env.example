# PostgreSQL container (compose.yml)
POSTGRES_DB=barber_app
POSTGRES_USER=barber_app
POSTGRES_PASSWORD=barber_app
POSTGRES_PORT=5432

# Spring datasource (application.properties)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/barber_app
SPRING_DATASOURCE_USERNAME=barber_app
SPRING_DATASOURCE_PASSWORD=barber_app

# Initial ADMIN user (created on startup only if no ADMIN exists)
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAMES=Barber App
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PHONE=+10000000000
INITIAL_ADMIN_PASSWORD=change-me

# CORS (application.properties app.cors.allowed-origins). Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP (application.properties spring.mail.*). Defaults: local Mailpit (compose.yml).
# Web UI to read received emails: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Example for Mailtrap sandbox:
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<mailtrap-username>
# MAIL_PASSWORD=<mailtrap-password>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

